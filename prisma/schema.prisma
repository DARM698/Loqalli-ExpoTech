generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id @default(cuid())
  fullName        String
  age             Int
  email           String        @unique
  password        String
  bio             String?
  role            Role
  createdAt       DateTime      @default(now())
  profileImage    String?
  bankInfo        BankInfo?
  Booking         Booking[]
  experiences     Experience[]
  writtenReviews  Review[]      @relation("WrittenReviews")
  receivedReviews Review[]      @relation("ReceivedReviews")
  transactions    Transaction[]
  verification    Verification?
}

model Experience {
  id              String        @id @default(cuid())
  title           String
  category        String
  description     String
  pricePerPerson  Float
  maxParticipants Int
  address         String
  lat             Float?
  lng             Float?
  days            String[]
  slots           String[]
  images          String[]
  status          String        @default("DRAFT")
  createdAt       DateTime      @default(now())
  hostId          String
  paymentMethod   PaymentMethod @default(CASH)
  endTime         String?
  startTime       String?
  arrivalImages   String[]
  Booking         Booking[]
  host            User          @relation(fields: [hostId], references: [id])
  reviews         Review[]
}

model Review {
  id           String      @id @default(cuid())
  rating       Int
  comment      String?
  createdAt    DateTime    @default(now())
  experienceId String?
  authorId     String
  targetUserId String?
  author       User        @relation("WrittenReviews", fields: [authorId], references: [id])
  experience   Experience? @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  targetUser   User?       @relation("ReceivedReviews", fields: [targetUserId], references: [id])

  @@index([experienceId])
  @@index([targetUserId])
}

model BankInfo {
  id            String   @id @default(cuid())
  userId        String   @unique
  accountHolder String
  bankName      String
  accountType   String
  accountNumber String
  routingNumber String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

model Verification {
  id        String             @id @default(cuid())
  userId    String             @unique
  faceImage String?
  document  String?
  status    VerificationStatus @default(PENDING)
  verified  Boolean            @default(false)
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id])
}

model Booking {
  id           String        @id @default(cuid())
  date         String
  time         String
  guests       Int
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  experienceId String
  touristId    String
  Experience   Experience    @relation(fields: [experienceId], references: [id])
  User         User          @relation(fields: [touristId], references: [id])
  Transaction  Transaction[]
}

model Transaction {
  id            String            @id @default(cuid())
  bookingId     String
  touristId     String
  totalAmount   Float
  loqalliFee    Float
  hostPayout    Float
  paymentStatus TransactionStatus @default(PENDING)
  payoutStatus  PayoutStatus      @default(NOT_APPLICABLE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  booking       Booking           @relation(fields: [bookingId], references: [id])
  tourist       User              @relation(fields: [touristId], references: [id])
}

enum Role {
  HOST
  TOURIST
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  NOT_APPLICABLE
  PENDING
  PAID
}


model Comments {
  id           String   @id @default(uuid())
  rating       Int      
  comment      String?  
  createdAt    DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  @@unique([userId, experienceId])
}
