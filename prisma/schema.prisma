generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HOST
  TOURIST
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  fullName     String
  age          Int
  email        String        @unique
  password     String
  bio          String?
  role         Role
  createdAt    DateTime      @default(now())
  
  bankInfo     BankInfo?
  verification Verification?
  experiences  Experience[]
  bookings     Booking[]     
}

enum PaymentMethod {
  CASH
  TRANSFER
}

model Experience {
  id              String        @id @default(cuid())
  title           String   
  category        String   
  description     String        @db.Text 
  pricePerPerson  Float    
  maxParticipants Int      
  address         String   
  lat             Float?
  lng             Float?
  days            String[] 
  slots           String[] 
  images          String[] 
  status          String        @default("DRAFT")
  createdAt       DateTime      @default(now())

  paymentMethod   PaymentMethod @default(CASH)

  hostId          String
  host            User          @relation(fields: [hostId], references: [id])
  bookings        Booking[] 
}

model BankInfo {
  id            String   @id @default(cuid())
  userId        String   @unique
  accountHolder String
  bankName      String
  accountType   String
  accountNumber String
  routingNumber String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Booking {
  id           String        @id @default(cuid())
  date         String        
  time         String        
  guests       Int           
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())

  experienceId String
  experience   Experience    @relation(fields: [experienceId], references: [id])

  touristId    String
  tourist      User          @relation(fields: [touristId], references: [id])
}

model Verification {
  id        String             @id @default(cuid())
  status    VerificationStatus @default(PENDING)
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id])
  createdAt DateTime           @default(now())

  // Añadimos los campos reales para que coincida exactamente con Supabase:
  document  String?            // O String, Prisma nos avisará si es obligatorio
  faceImage String?
  verified  Boolean            @default(false)
}